# Copia este archivo como .env y completa los valores reales.
# .env nunca se sube a git (ver .gitignore) — vive solo en esta máquina.

# Contraseña del rol neondb_owner en Neon (endpoint pooled o directo, misma clave)
DB_PASSWORD=

# Secreto HS256 para firmar JWT: debe ser Base64 ESTANDAR de al menos 32 bytes
# crudos (256 bits). Generar uno nuevo con:
#   python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(48)).decode())"
JWT_SECRET=

# Módulo de contenido curado (videos de indicación en las rutas de aprendizaje)
GOOGLE_BOOKS_API_KEY=
YOUTUBE_API_KEY=
